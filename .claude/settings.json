{
  "permissions": {
    "allow": [
      "Bash(python3 gen/kunst.py)",
      "Bash(python3 tools/baue.py)",
      "Bash(python3 tools/woerter.py)",
      "Bash(node tools/durchlauf.mjs *)",
      "Bash(python3 prototyp/fall1/baue.py)",
      "Bash(node prototyp/fall1/pruefe.mjs)",
      "Bash(python3 prototyp/bewegung/baue.py)",
      "Bash(node prototyp/bewegung/schuss.mjs *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/haken/texte_pruefen.py\"",
            "timeout": 20,
            "statusMessage": "Texte prüfen"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/haken/stand_pruefen.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
